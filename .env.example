# .env.example → .env.local にコピーして値を入れてください

# YouTube Data API v3
YOUTUBE_API_KEY=

# デフォルトの動画ID（OBS ブラウザソース URL に ?videoId= で上書き可）
YOUTUBE_VIDEO_ID=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# ゲーム画面キャプチャを送る際に使うモデル（Vision 対応が必要）
# gpt-5.4-mini が Vision 対応なら同じ値でOK
OPENAI_VISION_MODEL=gpt-4o-mini

# 音声合成エンジン
# voicevox: docker run -p 50021:50021 voicevox/voicevox_engine:cpu-ubuntu20.04-latest
# aivis   : AivisSpeech を起動 (VOICEVOX 互換 API、より自然な音声) → 乗り換え予定
TTS_PROVIDER=voicevox
VOICEVOX_URL=http://localhost:50021
# AivisSpeech に切り替える場合:
# TTS_PROVIDER=aivis
# VOICEVOX_URL=http://localhost:10101
VOICEVOX_SPEAKER_ID=1

# VTube Studio Plugin API（NEXT_PUBLIC_ = ブラウザ側から直接 WebSocket 接続）
# VTube Studio 側で「プラグイン許可」ポップアップが出るので承認すること
# 未設定の場合は VTube Studio 連携をスキップ（なしでも動作する）
NEXT_PUBLIC_VTS_WS_URL=ws://localhost:8001
# 発話終了後に戻すアイドル表情のホットキー名（省略可）
# 発話中の表情は AI が自動で決定するため設定不要（normal/happy/excited/surprised/shy/thinking）
NEXT_PUBLIC_VTS_HOTKEY_IDLE=idle
# リップシンク用パラメータ名（Live2Dモデルの口パクパラメータ名に合わせる）
# VTube Studio の「Parameters」タブで確認できる
NEXT_PUBLIC_VTS_PARAM_MOUTH_OPEN=MouthOpen

# OBS WebSocket v5（サーバーサイドからゲーム画面スクリーンショットを取得）
# OBS 28以降は標準搭載: ツール → WebSocketサーバー設定 → 有効化
# 未設定の場合はOBS連携をスキップ（なしでも動作する）
OBS_WS_URL=ws://localhost:4455
# OBS_WS_PASSWORD=your_password_here
# スクリーンショットを取るソース名（OBSのソース一覧に表示されている名前）
OBS_SOURCE_NAME=キャプチャカードデバイス

# Firestore
FIREBASE_PROJECT_ID=aivtuber-project-app
FIREBASE_DATABASE_ID=aivtuber-memory
# ローカル認証: gcloud auth application-default login で取得した ADC を使用
# GOOGLE_APPLICATION_CREDENTIALS は不要（ADC で自動解決）
